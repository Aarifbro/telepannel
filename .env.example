# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Telegram Bot Token(s) - get from @BotFather
# Multiple tokens can be added in config.py (API_TOKENS list)
BOT_TOKEN=your_bot_token_here

# Pyrogram / MTProto credentials - get from https://my.telegram.org
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# MongoDB connection string - get from https://cloud.mongodb.com
# Example: mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=telepannel_shop
